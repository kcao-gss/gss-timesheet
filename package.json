{
  "name": "gss-timesheet",
  "version": "1.0.0",
  "description": "GSS Time & Attendance desktop dashboard (Electron) with a CLI fallback",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node Get-Timesheet.js --cli",
    "test": "node Get-Timesheet.test.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gss.timesheet",
    "productName": "GSS Timesheet",
    "files": [
      "electron-main.js",
      "preload.js",
      "Get-Timesheet.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "win": { "target": "portable" },
    "portable": { "artifactName": "GSS-Timesheet.exe" }
  }
}
